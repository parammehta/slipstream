{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "demo",
  "installCommand": "echo 'no dependencies'",
  "buildCommand": "node --disable-warning=ExperimentalWarning scripts/build-demo.ts",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/app",
      "destination": "/search",
      "permanent": true
    }
  ]
}
